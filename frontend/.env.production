# ==============================================================================
# ExamShield Frontend - Vercel Production Environment Variables
# Add these under: Vercel Dashboard > Project > Settings > Environment Variables
# ==============================================================================

# Backend REST API endpoint (Points to your live backend on VPS)
REACT_APP_API_URL=https://exam.nexifyforge.in/api

# WebSocket / Socket.IO server URL (Used for real-time live monitoring and exam proctoring)
REACT_APP_WS_URL=https://exam.nexifyforge.in

# ChatBot & AI Question Assistance endpoint (optional)
REACT_APP_CHATBOT_API=/api/chatbot

# ==============================================================================
# Vercel Build Optimization & Compatibility Flags
# ==============================================================================

# Prevents CRA/Webpack from failing the build on lint warnings
CI=false
DISABLE_ESLINT_PLUGIN=true

# Skips source map generation for 2-3x faster deployment build and smaller bundle
GENERATE_SOURCEMAP=false

# Compatibility flag for OpenSSL in Node 18+ environments
NODE_OPTIONS=--openssl-legacy-provider
