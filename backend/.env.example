# Server
PORT=5000
NODE_ENV=development

# Neon PostgreSQL. Use the pooled URL for the application and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=15000

# Legacy local PostgreSQL fallback
DB_HOST=localhost
DB_PORT=5432
DB_NAME=CollegeExam
DB_USER=postgres
DB_PASSWORD=your_password

# Optional Supabase Auth fallback; database queries use Neon.
SUPABASE_AUTH_URL=https://your-project.supabase.co
SUPABASE_AUTH_ANON_KEY=your_supabase_publishable_or_anon_key

# JWT
JWT_SECRET=CollegeExam_jwt_secret_key_change_in_production_12345jgvjbuvgc
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CollegeExam_refresh_secret_key_change_in_production_123456
JWT_REFRESH_EXPIRES_IN=30d

# Email (Brevo / Nodemailer / Resend)
# Brevo (Recommended): Set EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_USER, and EMAIL_PASS (SMTP key)
# Or set BREVO_API_KEY to use Brevo's direct HTTPS REST API (guaranteed zero cloud port blocks)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_smtp_key
EMAIL_FROM=NexifyForge <exam@nexifyforge.in>
BREVO_API_KEY=
RESEND_API_KEY=

# Platform
PLATFORM_URL=https://www.exam.nexifyforge.in
FRONTEND_URL=https://www.exam.nexifyforge.in
ALLOWED_ORIGINS=https://exam.nexifyforge.in,https://www.exam.nexifyforge.in
STUDENT_LOGIN_URL=https://www.exam.nexifyforge.in/student/login

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (alternative)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Super Admin
SUPER_ADMIN_EMAIL=admin@CollegeExam.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_unique_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Online Code Execution Engine (Judge0 CE / RapidAPI)
# Leave empty to use default public Judge0 CE (https://ce.judge0.com), or specify your self-hosted / RapidAPI endpoint.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Redis Cluster & Socket.IO Horizontal Adapter (Upstash / AWS ElastiCache / Redis 7)
REDIS_URL=rediss://default:gQAAAAAAAvTCAAIgcDIxZTFmZTRlMjRlNjk0YjIwYjIyNGJiY2QzOGU4NjY1Nw@loving-gull-193730.upstash.io:6379
# Upstash REST API credentials (for Edge / Serverless / HTTP access):
UPSTASH_REDIS_REST_URL=https://loving-gull-193730.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAvTCAAIgcDIxZTFmZTRlMjRlNjk0YjIwYjIyNGJiY2QzOGU4NjY1Nw
