# Load Test Configuration Template
# Copy this file to load-tests/.env.test and populate with STAGING credentials.
# NEVER commit load-tests/.env.test or real credentials into version control!

# Target backend under test (staging or local instance)
BASE_URL=http://localhost:5000

# Target exam details (must exist in your staging database)
EXAM_ID=your-staging-exam-uuid-here
EXAM_KEY=your-staging-exam-key-here

# Target question IDs for the exam above
QUESTION_ID_1=your-staging-question-1-uuid
QUESTION_ID_2=your-staging-question-2-uuid

# Staged ramp profile: 10, 25, 50, 100, etc.
TARGET_VUS=50
